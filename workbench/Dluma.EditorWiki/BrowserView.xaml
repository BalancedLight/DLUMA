<UserControl x:Class="Dluma.EditorWiki.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Alternate}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource EditorTheme.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource EditorTheme.Panel}"
            BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="0,0,0,1" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
          <Button x:Name="BackButton" Content="Back" Click="OnBack" IsEnabled="False" />
          <Button x:Name="ForwardButton" Content="Forward" Click="OnForward" IsEnabled="False" />
          <Button x:Name="ReloadButton" Content="Reload" Click="OnReload" IsEnabled="False" />
          <Button x:Name="HomeButton" Content="Home" Click="OnHome" IsEnabled="False" />
        </WrapPanel>
        <TextBox x:Name="AddressBox" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,5,0,0"
                 Background="{DynamicResource EditorTheme.Alternate}"
                 Foreground="{DynamicResource EditorTheme.Text}"
                 BorderBrush="{DynamicResource EditorTheme.Border}" Padding="7,5" />
      </Grid>
    </Border>
    <wv:WebView2 x:Name="Browser" Grid.Row="1" />
    <Border x:Name="MessagePanel" Grid.Row="1" Background="{DynamicResource EditorTheme.Window}" Visibility="Collapsed">
      <TextBlock x:Name="MessageText" Foreground="{DynamicResource EditorTheme.Text}"
                 TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                 MaxWidth="500" Margin="24" />
    </Border>
    <TextBlock x:Name="PageTitle" Grid.Row="2" Text="Wiki" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource EditorTheme.MutedText}" Background="{DynamicResource EditorTheme.Panel}"
               Padding="8,4" />
  </Grid>
</UserControl>
