<Application x:Class="Dluma.Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#10141B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181F29" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#222C39" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F18A2A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A7B1BE" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Padding" Value="0,6,8,3" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#3A4656" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
      <Setter Property="Foreground" Value="#10141B" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#465468" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#15100B" />
      <Setter Property="BorderBrush" Value="#FFA451" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="RowBackground" Value="{StaticResource PanelBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAltBrush}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#344050" />
      <Setter Property="BorderBrush" Value="#344050" />
    </Style>
  </Application.Resources>
</Application>
