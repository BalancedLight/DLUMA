<Window x:Class="Dluma.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLUMA Mod Creator 0.5" Width="1320" Height="850"
        MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="DLUMA MOD CREATOR" FontSize="25" FontWeight="SemiBold" />
        <TextBlock x:Name="CatalogSummary" Text="DLUMA API 1.0" Foreground="{StaticResource AccentBrush}" FontSize="13" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,8">
        <TextBlock x:Name="PrerequisiteSummary" Text="Checking prerequisites..." Foreground="{StaticResource MutedBrush}" />
      </Border>
    </Grid>

    <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#344050">
      <TabItem Header="New Mod">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="Create a DLUMA API 1.0 package" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
            <Label Grid.Row="1" Content="Language" />
            <ComboBox x:Name="NewLanguage" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="NewLanguageChanged">
              <ComboBoxItem Content="Lua — novice / sandboxed" Tag="Lua" />
              <ComboBoxItem Content="C# — intermediate / full trust" Tag="CSharp" />
              <ComboBoxItem Content="C/C++ — expert / native" Tag="Native" />
            </ComboBox>
            <Label Grid.Row="2" Content="Scope" />
            <ComboBox x:Name="NewScope" Grid.Row="2" Grid.Column="1" SelectedIndex="0" SelectionChanged="NewScopeChanged">
              <ComboBoxItem Content="Global" Tag="Global" />
              <ComboBoxItem Content="Project" Tag="Project" />
              <ComboBoxItem Content="Exact map" Tag="Map" />
            </ComboBox>
            <Label Grid.Row="3" Content="Stable mod ID" />
            <TextBox x:Name="NewId" Grid.Row="3" Grid.Column="1" Text="author.example-mod" />
            <Label Grid.Row="4" Content="Name" />
            <TextBox x:Name="NewName" Grid.Row="4" Grid.Column="1" Text="Example Mod" />
            <Label Grid.Row="5" Content="Version" />
            <TextBox x:Name="NewVersion" Grid.Row="5" Grid.Column="1" Text="1.0.0" />
            <Label Grid.Row="6" Content="Author" />
            <TextBox x:Name="NewAuthor" Grid.Row="6" Grid.Column="1" Text="Mod Author" />
            <Label Grid.Row="7" Content="Description" />
            <TextBox x:Name="NewDescription" Grid.Row="7" Grid.Column="1" Text="A DLUMA API 1.0 mod." />
            <Label x:Name="MapLabel" Grid.Row="8" Content="Internal map name" Visibility="Collapsed" />
            <TextBox x:Name="NewMap" Grid.Row="8" Grid.Column="1" Visibility="Collapsed" />
            <Label x:Name="EntryTypeLabel" Grid.Row="9" Content="C# entry type" Visibility="Collapsed" />
            <TextBox x:Name="NewEntryType" Grid.Row="9" Grid.Column="1" Text="ExampleMod.Mod" Visibility="Collapsed" />
            <Label Grid.Row="10" Content="Output root" />
            <Grid Grid.Row="10" Grid.Column="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="NewOutputRoot" />
              <Button Grid.Column="1" Content="Browse" Click="BrowseNewOutput" />
            </Grid>
            <CheckBox x:Name="NewConfiguration" Grid.Row="11" Grid.Column="1" Content="Include mod settings" Foreground="{StaticResource TextBrush}" Margin="0,8,0,12" IsChecked="True" />

            <Border Grid.Column="3" Grid.RowSpan="11" Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="18">
              <StackPanel>
                <TextBlock Text="Requested access" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="The same declarations gate Lua, C#, and native SDK calls. C# and native code remain full trust." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                <ListBox x:Name="AccessList" SelectionMode="Multiple" Height="390" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="#3A4656" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="Create Mod" Click="CreateMod" />
              <Button Content="Open Folder" Click="OpenCreatedFolder" />
              <TextBlock x:Name="CreateStatus" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="API Explorer">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="230" /></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ApiSearch" TextChanged="ApiFilterChanged" ToolTip="Search operation, capability, or documentation" />
            <ComboBox x:Name="ApiDomain" Grid.Column="1" SelectionChanged="ApiFilterChanged" />
            <ComboBox x:Name="ApiStatus" Grid.Column="2" SelectionChanged="ApiFilterChanged" />
            <ComboBox x:Name="ApiScope" Grid.Column="3" SelectionChanged="ApiFilterChanged" />
            <ComboBox x:Name="ApiAccess" Grid.Column="4" SelectionChanged="ApiFilterChanged" />
            <ComboBox x:Name="SnippetLanguage" Grid.Column="5" SelectedIndex="0" SelectionChanged="ApiSelectionChanged">
              <ComboBoxItem Content="Lua" Tag="Lua" /><ComboBoxItem Content="C#" Tag="CSharp" /><ComboBoxItem Content="C++" Tag="Native" />
            </ComboBox>
          </Grid>
          <DataGrid x:Name="ApiGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ApiSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Operation" Binding="{Binding Id}" Width="2*" />
              <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
              <DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="1.5*" />
              <DataGridTextColumn Header="Thread" Binding="{Binding Thread}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="14" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock x:Name="ApiTitle" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="ApiDocumentation" TextWrapping="Wrap" Margin="0,8,0,8" />
                <TextBlock x:Name="ApiContracts" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid Grid.Column="1">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox x:Name="ApiSnippet" FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
              <Button Grid.Row="1" HorizontalAlignment="Right" Content="Copy snippet" Click="CopySnippet" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Lua Editor">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Content="Open Lua" Click="OpenLua" /><Button Content="Save" Click="SaveLua" /><Button Style="{StaticResource PrimaryButton}" Content="Run diagnostics" Click="AnalyzeLua" />
            <TextBlock x:Name="LuaPath" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <TextBox x:Name="LuaEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          <ListBox x:Name="LuaDiagnostics" Grid.Row="2" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="#3A4656" />
        </Grid>
      </TabItem>

      <TabItem Header="Build &amp; Package">
        <Grid Margin="22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Label Content="Mod directory" />
          <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="BuildModDirectory" /><Button Grid.Column="1" Content="Browse" Click="BrowseBuildMod" /></Grid>
          <Label Grid.Row="1" Content="Language" />
          <ComboBox x:Name="BuildLanguage" Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Lua" Tag="Lua" /><ComboBoxItem Content="C#" Tag="CSharp" /><ComboBoxItem Content="C/C++" Tag="Native" /></ComboBox>
          <Label Grid.Row="2" Content="Package output" />
          <TextBox x:Name="PackageOutput" Grid.Row="2" Grid.Column="1" />
          <Label Grid.Row="3" Content="Stage destination" />
          <Grid Grid.Row="3" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="StageDestination" /><Button Grid.Column="1" Content="Browse" Click="BrowseStage" /></Grid>
          <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,4">
            <Button Content="Build" Click="BuildMod" /><Button Content="Validate" Click="ValidateMod" /><Button Content="Generate lock" Click="LockMod" /><Button Style="{StaticResource PrimaryButton}" Content="Package" Click="PackageMod" /><Button Content="Stage" Click="StageMod" /><Button Content="Open logs" Click="OpenLogs" /><Button Background="#842D2D" Content="Launch Player..." Click="LaunchPlayer" />
          </WrapPanel>
          <TextBox x:Name="BuildOutput" Grid.Row="5" Grid.ColumnSpan="2" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}" Text="Enable installed mods from the in-game Mods menu." />
  </Grid>
</Window>
