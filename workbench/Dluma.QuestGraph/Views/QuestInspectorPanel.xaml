<UserControl x:Class="Dluma.QuestGraph.Views.QuestInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dluma.QuestGraph.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="14">
    <Grid>
      <TextBlock Text="Select a node"
                 Foreground="{StaticResource MutedBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="12,30">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasInspectorSelection}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasInspectorSelection}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <TextBlock Text="INSPECTOR"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,0,9" />
        <TextBlock Text="{Binding InspectorTitle}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding InspectorSummary}"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <ItemsControl ItemsSource="{Binding InspectorFields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:QuestInspectorFieldViewModel}">
              <StackPanel Margin="0,0,0,11">
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Optional"
                             DockPanel.Dock="Right"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="11">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOptional}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding DisplayName}"
                             FontWeight="SemiBold"
                             ToolTip="{Binding Description}" />
                </DockPanel>

                <TextBox Text="{Binding DraftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}"
                         ToolTip="{Binding Description}"
                         PreviewKeyDown="OnTextEditorKeyDown"
                         LostKeyboardFocus="OnTextEditorLostKeyboardFocus">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTextEditor}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <ComboBox ItemsSource="{Binding Options}"
                          Text="{Binding DraftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEdit}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ToolTip="{Binding Description}"
                          SelectionChanged="OnPickerSelectionChanged"
                          DropDownOpened="OnPickerDropDownOpened"
                          DropDownClosed="OnPickerDropDownClosed"
                          PreviewKeyDown="OnTextEditorKeyDown"
                          LostKeyboardFocus="OnTextEditorLostKeyboardFocus">
                  <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPickerEditor}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ComboBox.Style>
                </ComboBox>

                <CheckBox Content="Enabled"
                          IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsThreeState="{Binding IsThreeStateBoolean}"
                          IsEnabled="{Binding CanEdit}"
                          Click="OnBooleanClick">
                  <CheckBox.Style>
                    <Style TargetType="CheckBox">
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBooleanEditor}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </CheckBox.Style>
                </CheckBox>

                <Border Background="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8,6">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLiteralEditor}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding DraftValue}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#E98A85"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Advanced" IsExpanded="False" Margin="0,4,0,10">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Raw PXSL" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SelectedNode.SourcePreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsSelectedRawReadOnly}"
                     AcceptsReturn="True"
                     MinHeight="110"
                     FontFamily="Cascadia Mono"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <Button Content="Apply"
                    Command="{Binding ApplySourceCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left"
                    Margin="0,7,0,0" />
          </StackPanel>
        </Expander>

        <WrapPanel>
          <Button Content="Focus in PXSL" Command="{Binding FocusSourceCommand}" />
          <Button Content="Delete" Command="{Binding DeleteNodeCommand}" />
        </WrapPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
