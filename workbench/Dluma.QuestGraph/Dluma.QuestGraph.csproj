<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dluma.QuestGraph</AssemblyName>
    <RootNamespace>Dluma.QuestGraph</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\build\generated\editor-theme\EditorThemeRoles.g.cs" Link="Generated\EditorThemeRoles.g.cs" />
    <Page Include="..\..\build\generated\editor-theme\ThemeDefaults.xaml" Link="Themes\ThemeDefaults.xaml" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <ProjectReference Include="..\Dluma.QuestGraph.Core\Dluma.QuestGraph.Core.csproj" />
  </ItemGroup>

  <Target Name="GenerateEditorTheme" BeforeTargets="PrepareForBuild">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\..\tools\generate_editor_theme.py&quot;" />
  </Target>

  <ItemGroup>
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Licenses\Nodify-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
