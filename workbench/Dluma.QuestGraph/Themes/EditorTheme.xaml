<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ThemeDefaults.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
  </Style>
  <Style TargetType="ContextMenu">
    <Style.Resources>
      <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="{DynamicResource EditorTheme.Border}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Style.Resources>
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="IconPresenter" Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Path x:Name="CheckMark" Grid.Column="0" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                    StrokeThickness="1.6" Data="M 0,4 L 3,7 L 9,0" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                         Text="{TemplateBinding InputGestureText}" />
              <Path x:Name="SubmenuArrow" Grid.Column="3" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="7,0,1,0"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                    Data="M 0,0 L 4,4 L 0,8 Z" />
              <Popup x:Name="PART_Popup" Placement="Right" Focusable="False" AllowsTransparency="True"
                     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                     IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{DynamicResource EditorTheme.Panel}"
                        BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="1">
                  <ScrollViewer MaxHeight="480" MaxWidth="600"
                                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                CanContentScroll="True" Focusable="False">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
              <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
              <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EditorScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Border}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Body" Background="{TemplateBinding Background}" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource EditorTheme.Hover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource EditorTheme.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource EditorScrollThumb}" /></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand" />
              <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="14" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
