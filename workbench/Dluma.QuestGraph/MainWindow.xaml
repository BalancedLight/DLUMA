<Window x:Class="Dluma.QuestGraph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dluma.QuestGraph.Views"
        Title="Dying Light Visual PXSL Quest Editor"
        Width="1540"
        Height="930"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCommand}" />
    <KeyBinding Key="F7" Command="{Binding CompileCommand}" />
  </Window.InputBindings>

  <Grid Background="{DynamicResource EditorTheme.Window}"
        TextElement.Foreground="{DynamicResource EditorTheme.Text}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource EditorTheme.Panel}" BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="0,0,0,1" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <Button Content="Open PXSL" Command="{Binding OpenCommand}" ToolTip="Open a persisted PXSL document (Ctrl+O)" />
            <Button Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
            <Button Content="Save All" Command="{Binding SaveAllCommand}" />
            <Button Content="Save Copy" Command="{Binding SaveCopyCommand}" />
            <Button Content="Compile" Style="{StaticResource PrimaryButton}" Command="{Binding CompileCommand}" ToolTip="Compile (F7)" />
            <Separator Margin="5,0,12,0" />
            <Button Content="Load Definitions" Command="{Binding LoadCatalogCommand}" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
          <Ellipse Width="9" Height="9" Fill="{DynamicResource EditorTheme.Accent}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ConnectionStatus}"
                     Foreground="{DynamicResource EditorTheme.MutedText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" MinWidth="190" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="310" MinWidth="250" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource EditorTheme.Panel}" BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="0,0,1,0" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="NODE PALETTE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource EditorTheme.MutedText}" Margin="2,0,0,8" />
          <TextBox Grid.Row="1" Text="{Binding PaletteSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Search all runtime-catalog macros" />
          <ListBox x:Name="PaletteList"
                   Grid.Row="2"
                   ItemsSource="{Binding PaletteItemsView}"
                   SelectedItem="{Binding SelectedPaletteItem}"
                   PreviewMouseLeftButtonDown="OnPaletteMouseLeftButtonDown"
                   PreviewMouseMove="OnPaletteMouseMove"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                          <Expander IsExpanded="True"
                                    Margin="0,2,0,4"
                                    Foreground="{DynamicResource EditorTheme.Text}">
                            <Expander.Header>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ItemCount, StringFormat=  ({0})}" Foreground="{DynamicResource EditorTheme.MutedText}" />
                              </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter Margin="10,3,0,0" />
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{Binding HeaderColor}" BorderThickness="3,0,0,0" Padding="7,3,3,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource EditorTheme.MutedText}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                              <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Insert after" Command="{Binding InsertAfterCommand}" />
            <Button Grid.Column="1" Content="Add child" Command="{Binding AddChildCommand}" Margin="0" />
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource EditorTheme.Border}" />

      <Grid Grid.Column="2">
        <TabControl ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TabTitle}" />
                <Button Content="&#x00D7;" Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0" Margin="6,0,0,0"
                        ToolTip="Close (Ctrl+W)"
                        Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=TabControl}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <views:QuestDocumentView />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <Border Background="{DynamicResource EditorTheme.Window}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasDocuments}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <TextBlock Text="Visual PXSL Quest Editor" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Open a PXSL quest to begin."
                       TextAlignment="Center"
                       Foreground="{DynamicResource EditorTheme.MutedText}"
                       Margin="0,12,0,22" />
            <Button Content="Open PXSL" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource EditorTheme.Border}" />

      <Border Grid.Column="4" Background="{DynamicResource EditorTheme.Panel}" BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="1,0,0,0">
        <views:QuestInspectorPanel DataContext="{Binding ActiveDocument}" />
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource EditorTheme.Panel}"
            BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="0,1,0,0" Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding GlobalStatus}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GlobalStatus}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock Text="{Binding GlobalStatus}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
