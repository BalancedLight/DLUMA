<UserControl x:Class="Dluma.EditorGit.GitView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource EditorTheme.Text}"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,5,5" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Alternate}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Hover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Window}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="SelectionBrush" Value="{DynamicResource EditorTheme.Selection}" />
      <Setter Property="SelectionTextBrush" Value="{DynamicResource EditorTheme.SelectionText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.MutedText}" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource EditorTheme.Hover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                <ToggleButton x:Name="DropDown" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                              Foreground="{TemplateBinding Foreground}"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent">
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                      </Grid>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Selection" Margin="6,4" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1" Padding="5,3" BorderThickness="0"
                         Background="Transparent" Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}" />
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Border MinWidth="{TemplateBinding ActualWidth}" Background="{DynamicResource EditorTheme.Surface}"
                        BorderBrush="{DynamicResource EditorTheme.Border}" BorderThickness="1">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="DropDown" Property="Grid.Column" Value="1" />
                <Setter TargetName="DropDown" Property="Grid.ColumnSpan" Value="1" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Hover}" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Accent}" /></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorTheme.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTheme.DisabledText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource EditorTheme.Window}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTheme.Text}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource EditorTheme.Selection}" />
          <Setter Property="Foreground" Value="{DynamicResource EditorTheme.SelectionText}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource EditorTheme.Window}" Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="GitExecutable" IsReadOnly="True" ToolTip="Git executable" Margin="0,0,6,6" />
      <Button Grid.Column="1" Content="Choose Git…" Click="OnChooseGit" />
    </Grid>
    <Grid x:Name="Actions" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <WrapPanel>
        <Button Content="Refresh" Click="OnRefresh" />
        <Button x:Name="Initialize" Content="Initialize" Click="OnInitialize" />
        <Button x:Name="Stage" Content="Stage" Click="OnStage" />
        <Button x:Name="Unstage" Content="Unstage" Click="OnUnstage" />
        <Button x:Name="Push" Content="Push" Click="OnPush" />
        <Button x:Name="Pull" Content="Pull" Click="OnPull" ToolTip="Save and close project documents before pulling." />
        <Button x:Name="Fetch" Content="Fetch" Click="OnFetch" />
        <Button x:Name="Publish" Content="Publish branch" Click="OnPublish" />
        <Button x:Name="History" Content="History" Click="OnHistory" />
        <Button x:Name="Clone" Content="Clone…" Click="OnClone" />
      </WrapPanel>
      <WrapPanel Grid.Row="1">
        <ComboBox x:Name="BranchName" Width="180" Margin="0,0,5,5" IsEditable="True" ToolTip="Branch name" />
        <Button x:Name="NewBranch" Content="New branch" Click="OnCreateBranch" />
        <Button x:Name="SwitchBranch" Content="Switch" Click="OnSwitchBranch" ToolTip="Save and close project documents before switching." />
        <TextBlock x:Name="BranchStatus" VerticalAlignment="Center" Margin="4,0,0,5" />
      </WrapPanel>
      <WrapPanel Grid.Row="2">
        <ComboBox x:Name="RemotePicker" Width="210" Margin="0,0,5,5" ToolTip="Remote">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" /><TextBlock Text="  " /><TextBlock Text="{Binding DisplayUrl}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox x:Name="RemoteName" Width="105" Margin="0,0,5,5" ToolTip="Remote name" />
        <TextBox x:Name="AddRemoteUrl" Width="220" Margin="0,0,5,5" ToolTip="HTTPS or SSH repository URL" />
        <Button x:Name="AddRemote" Content="Add remote" Click="OnAddRemote" />
      </WrapPanel>
    </Grid>
    <Grid Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DataGrid x:Name="Changes" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
              Background="{DynamicResource EditorTheme.Window}" Foreground="{DynamicResource EditorTheme.Text}"
              BorderBrush="{DynamicResource EditorTheme.Border}" GridLinesVisibility="None"
              HeadersVisibility="Column" EnableRowVirtualization="True" MinHeight="80">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Staged" Binding="{Binding Index}" Width="62" />
        <DataGridTextColumn Header="Changed" Binding="{Binding WorkTree}" Width="72" />
        <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
        <DataGridTextColumn Header="Previous name" Binding="{Binding OriginalPath}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid x:Name="HistoryList" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" Background="{DynamicResource EditorTheme.Window}"
              Foreground="{DynamicResource EditorTheme.Text}" BorderBrush="{DynamicResource EditorTheme.Border}"
              GridLinesVisibility="None" HeadersVisibility="Column" EnableRowVirtualization="True" MinHeight="80">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Commit" Binding="{Binding Oid}" Width="160" />
        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="140" />
        <DataGridTextColumn Header="Date" Binding="{Binding Time}" Width="160" />
        <DataGridTextColumn Header="Message" Binding="{Binding Subject}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="1" Margin="0,4,0,0">
      <Button Content="Staged diff" Click="OnStagedDiff" />
      <Button Content="Working diff" Click="OnWorkingDiff" />
      <Button Content="Close diff" Click="OnCloseDiff" />
    </WrapPanel>
    <TextBox x:Name="DiffText" Grid.Row="2" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas" Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Grid>
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="CommitMessage" ToolTip="Commit message" MinHeight="32" Margin="0,0,6,5" />
      <Button x:Name="Commit" Grid.Column="1" Content="Commit…" Click="OnCommit" />
    </Grid>
    <Grid Grid.Row="4" x:Name="CloneOptions" Visibility="Collapsed" Margin="0,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBox x:Name="RemoteUrl" ToolTip="HTTPS or SSH repository URL" Margin="0,0,0,5" />
      <TextBox x:Name="CloneDestination" Grid.Row="1" ToolTip="New checkout folder (full path)" Margin="0,0,0,5" />
      <WrapPanel Grid.Row="2"><Button Content="Clone" Click="OnCloneStart" /><Button Content="Close" Click="OnCloneClose" /></WrapPanel>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,6,0,0">
      <Button x:Name="Cancel" DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" IsEnabled="False" />
      <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</UserControl>
