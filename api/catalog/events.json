    {
      "id": "events.update.subscribe",
      "ordinal": 1,
      "status": "implemented",
      "capability": "core.runtime",
      "access": [],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "game",
      "request": "DlumaEventSubscribeRequest",
      "result": "DlumaTokenResult",
      "limits": {
        "subscriptions_per_owner": 128
      },
      "errors": [
        "invalid_argument",
        "wrong_thread",
        "quota_exceeded",
        "owner_revoked"
      ],
      "documentation": "Subscribes a callback to the bounded game-thread frame dispatcher.",
      "adapters": {
        "core": "dluma_events_subscribe_update",
        "lua": "mod:on_update",
        "csharp": "IModContext.Events.Updated",
        "c": "DlumaEventsV1.subscribe_update",
        "cpp": "context.events().on_update"
      },
      "tests": [
        "event_update_contract",
        "event_callback_mutation"
      ]
    },
