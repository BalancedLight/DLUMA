  "operations": [
    {
      "id": "core.log",
      "ordinal": 1,
      "status": "implemented",
      "capability": "core.runtime",
      "access": [],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "any",
      "request": "DlumaLogRequest",
      "result": "DlumaCallResult",
      "limits": {
        "level_bytes": 16,
        "message_bytes": 1024,
        "messages_per_second": 32
      },
      "errors": [
        "invalid_argument",
        "limit_exceeded",
        "owner_revoked"
      ],
      "documentation": "Writes a bounded owner-attributed message to the loader log.",
      "adapters": {
        "core": "dluma_core_log",
        "lua": "dluma.log",
        "csharp": "IModContext.Log",
        "c": "DlumaCoreV1.log",
        "cpp": "context.log"
      },
      "tests": [
        "core_log_contract",
        "core_log_rate_limit"
      ]
    },
    {
