  "operations": [
    {
      "id": "hud.show",
      "ordinal": 1,
      "status": "gated",
      "capability": "hud.visibility",
      "access": [
        "ui.overlay"
      ],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "game",
      "request": "DlumaHudVisibilityRequest",
      "result": "DlumaBoolResult",
      "limits": {
        "target_bytes": 383,
        "screen_bytes": 127,
        "active_rules": 88,
        "tree_elements": 8192
      },
      "errors": [
        "invalid_argument",
        "access_denied",
        "unsupported_capability",
        "wrong_thread",
        "not_found",
        "limit_exceeded"
      ],
      "documentation": "Keeps the selected HUD element visible until this owner resets it. Hide requests from any owner take precedence. Targets accept health, stamina, radar, weapons, crosshair, reload, screen, an exact authored ID, or a slash-separated path from the screen root. An empty screen selects HUD.xui. IDs and path segments are case-sensitive; ambiguous targets are rejected. Overrides expire on map changes and owner unload.",
      "adapters": {
        "core": "dluma_game_hud_show",
        "lua": "dluma.hud.show",
        "csharp": "IModContext.Hud.Show",
        "c": "DlumaHudV1.show",
        "cpp": "context.hud().show"
      },
      "tests": [
        "api_catalog_contract"
      ]
    },
