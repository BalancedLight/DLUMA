      "ordinal": 3,
      "status": "implemented",
      "capability": "storage.mod",
      "access": [
        "storage.mod"
      ],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "any",
      "request": "DlumaConfigGetRequest",
      "result": "DlumaBoolResult",
      "limits": {
        "key_bytes": 128
      },
      "errors": [
        "invalid_argument",
        "access_denied",
        "storage_write_failed",
        "owner_revoked"
      ],
      "documentation": "Deletes one owner-isolated persistent scalar value.",
      "adapters": {
        "core": "dluma_storage_delete",
        "lua": "dluma.storage.delete",
        "csharp": "IModContext.Storage.Delete",
        "c": "DlumaStorageV1.delete_value",
        "cpp": "context.storage().erase"
      },
      "tests": [
        "storage_delete_contract"
      ]
