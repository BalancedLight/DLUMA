    {
      "id": "player.variable_get",
      "ordinal": 9,
      "status": "gated",
      "capability": "player.read",
      "access": [
        "player.read"
      ],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "game",
      "request": "DlumaPlayerVariableRequest",
      "result": "DlumaPlayerVariableResult",
      "limits": {
        "name_bytes": 64
      },
      "errors": [
        "invalid_argument",
        "access_denied",
        "unsupported_capability",
        "wrong_thread",
        "stale_handle",
        "not_found"
      ],
      "documentation": "Reads one copied allowlisted raw PlayerVariables tuning snapshot. Names such as max_health and base_max_health are not current health or the computed PlayerDI maximum-health result.",
