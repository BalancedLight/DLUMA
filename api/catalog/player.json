      "status": "gated",
      "capability": "player.read",
      "access": [
        "world.write"
      ],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "game",
      "request": "DlumaPlayerVariableSetRequest",
      "result": "DlumaBoolResult",
      "limits": {
        "name_bytes": 64,
        "overrides_per_owner": 64
      },
      "errors": [
        "invalid_argument",
        "access_denied",
        "scope_denied",
        "unsupported_capability",
        "wrong_thread",
        "stale_handle"
      ],
      "documentation": "Transactionally applies one bounded transient allowlisted raw PlayerVariables tuning override; invalid or non-finite derived values leave game memory unchanged.",
      "adapters": {
        "core": "dluma_game_player_variable_set",
        "lua": "player:set_variable",
        "csharp": "IPlayer.SetVariable",
        "c": "DlumaPlayerV1.variable_set",
        "cpp": "player.set_variable"
      },
      "tests": [
