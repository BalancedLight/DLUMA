      "id": "player.local",
      "ordinal": 1,
      "status": "gated",
      "capability": "player.read",
      "access": [
        "player.read"
      ],
      "scopes": [
        "global",
        "project",
        "map"
      ],
      "thread": "game",
      "request": "DlumaNoRequest",
      "result": "DlumaObjectResult",
      "limits": {
        "handles_per_owner": 8
      },
      "errors": [
        "access_denied",
        "unsupported_capability",
        "wrong_thread",
        "not_ready",
        "owner_revoked"
      ],
      "documentation": "Returns the opaque generation-bound local-player handle.",
      "adapters": {
        "core": "dluma_game_player_local",
        "lua": "dluma.player.local_player",
        "csharp": "IModContext.Player.Local",
        "c": "DlumaPlayerV1.local_player",
        "cpp": "context.player().local"
      },
      "tests": [
        "player_local_contract",
        "player_local_map_transition"
      ]
    },
