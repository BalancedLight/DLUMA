<!-- Project-owned example source. Merge EffectPanel into your existing HUD
     scene. This canvas is for authoring/preview; it is not a complete game HUD. -->
<XuiCanvas version="000c">
    <Properties><Width>1280</Width><Height>720</Height></Properties>
    <XuiScene>
        <Properties>
            <Id>HUD</Id><Width>1280</Width><Height>720</Height>
            <ClassOverride>UIScreen</ClassOverride>
        </Properties>
        <AdvGroup>
            <Properties>
                <Id>EffectPanel</Id><Width>480</Width><Height>80</Height>
                <Position>400,160,0</Position><Show>false</Show>
            </Properties>
            <MyImage>
                <Properties>
                    <Id>Visual</Id><Width>480</Width><Height>80</Height>
                    <Position>0,0,0</Position><ImagePath>white</ImagePath>
                    <Color>0xffffffff</Color><Opacity>1</Opacity>
                    <UseVertexColor>true</UseVertexColor>
                </Properties>
            </MyImage>
            <MyText>
                <Properties>
                    <Id>Label</Id><Width>448</Width><Height>64</Height>
                    <Position>16,8,0</Position>
                    <Text>&amp;DLUMA_Example_EffectOne&amp;</Text>
                    <Font>HUDTextNormal</Font><TextColor>0xff202020</TextColor>
                    <MultiLine>true</MultiLine>
                </Properties>
            </MyText>
            <Timelines>
                <NamedFrames>
                    <NamedFrame><Name>Idle</Name><Time>0</Time><Command>stop</Command></NamedFrame>
                    <NamedFrame><Name>Shake</Name><Time>1</Time></NamedFrame>
                    <NamedFrame><Name>EndShake</Name><Time>13</Time><Command>stop</Command></NamedFrame>
                </NamedFrames>
                <Timeline>
                    <Id>Visual</Id><TimelineProp>Position</TimelineProp>
                    <KeyFrame><Time>0</Time><Interpolation>0</Interpolation><Prop>0,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>1</Time><Interpolation>0</Interpolation><Prop>0,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>3</Time><Interpolation>0</Interpolation><Prop>-6,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>5</Time><Interpolation>0</Interpolation><Prop>6,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>7</Time><Interpolation>0</Interpolation><Prop>-6,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>9</Time><Interpolation>0</Interpolation><Prop>6,0,0</Prop></KeyFrame>
                    <KeyFrame><Time>13</Time><Interpolation>0</Interpolation><Prop>0,0,0</Prop></KeyFrame>
                </Timeline>
            </Timelines>
        </AdvGroup>
    </XuiScene>
</XuiCanvas>
