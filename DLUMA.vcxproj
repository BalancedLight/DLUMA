  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
  <PropertyGroup>
    <DlumaBuildProvenanceArchiveArgument Condition="'$(DLUMAAllowSourceArchiveProvenance)' == 'true' or !Exists('$(ProjectDir).git')">--allow-source-archive</DlumaBuildProvenanceArchiveArgument>
  </PropertyGroup>
  <Target Name="GenerateDlumaBuildProvenance">
    <MakeDir Directories="$(ProjectDir)build\generated" />
    <Exec Command="python &quot;$(ProjectDir)tools\generate_build_provenance.py&quot; --repo &quot;$(ProjectDir).&quot; --output &quot;$(ProjectDir)build\generated\dlw_build_provenance.h&quot; $(DlumaBuildProvenanceArchiveArgument)" />
  </Target>
  <Target Name="PrepareDlumaBuildDirectories"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="GenerateDlumaBuildProvenance"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(IntDir);$(OutDir);$(DlumaPackageDir)" />
    <MakeDir Directories="$(IntDir);$(OutDir);$(DlumaPackageDir)" />
  </Target>
  <Target Name="VerifyDlumaObjectManifest"
          BeforeTargets="Link"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python &quot;$(ProjectDir)tools\verify_msvc_object_manifest.py&quot; --project &quot;$(ProjectPath)&quot; --object-dir &quot;$(IntDir).&quot;" />
  </Target>
  <Target Name="VerifyPlayerDiOnDestroyRelay"
          BeforeTargets="ClCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python &quot;$(ProjectDir)tools\verify_playerdi_ondestroy_relay.py&quot; --self-test" />
  </Target>
  <Target Name="GenerateLoaderSymbolManifest"
          AfterTargets="Link"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python &quot;$(ProjectDir)tools\generate_loader_symbol_manifest.py&quot; --image &quot;$(TargetPath)&quot; --pdb &quot;$(OutDir)$(TargetName).pdb&quot; --map &quot;$(DlumaLoaderMapPath)&quot; --output &quot;$(DlumaLoaderAddressManifestPath)&quot; --source-root &quot;$(ProjectDir).&quot;" />
  </Target>
  <Target Name="PackageWorkshop"
           AfterTargets="Build"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(DlumaSkipPackage)' != 'true'">
    <RemoveDir Directories="$(DlumaPackageDir)" />
    <MakeDir Directories="$(DlumaPackageDir)" />
    <Exec Command="call &quot;$(ProjectDir)tools\build_lua54_helper_msvc.bat&quot; $(Configuration) &quot;$(OutDir).&quot;" />
    <Exec Command="call &quot;$(ProjectDir)tools\build_discord_presence_helper_msvc.bat&quot; $(Configuration) &quot;$(OutDir).&quot;" />
    <Exec Command="dotnet build &quot;$(ProjectDir)sdk\dotnet\Dluma.Managed.slnx&quot; -c $(Configuration) --nologo -p:Platform=&quot;Any CPU&quot;" />
    <RemoveDir Directories="$(DlumaQuestGraphOutputDir)" />
    <Exec Command="dotnet restore &quot;$(ProjectDir)workbench\Dluma.QuestGraph\Dluma.QuestGraph.csproj&quot; --locked-mode --nologo" />
    <Exec Command="dotnet publish &quot;$(ProjectDir)workbench\Dluma.QuestGraph\Dluma.QuestGraph.csproj&quot; -c $(Configuration) --no-restore --nologo -o &quot;$(DlumaQuestGraphOutputDir).&quot;" />
    <Exec Command="dotnet publish &quot;$(ProjectDir)tools\Dluma.NightlyUpdater\Dluma.NightlyUpdater.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true --nologo -o &quot;$(OutDir)nightly-helper&quot;" />
    <Copy SourceFiles="$(OutDir)nightly-helper\Dluma.NightlyUpdater.exe" DestinationFiles="$(DlumaPackageDir)dluma_nightly_updater.exe" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(DlumaPackageDir)$(TargetFileName)" />
    <Copy SourceFiles="$(ProjectDir)LICENSE;$(ProjectDir)THIRD_PARTY_NOTICES.md" DestinationFolder="$(DlumaPackageDir)" />
    <Copy
          SourceFiles="$(OutDir)dluma_lua54.dll;$(OutDir)LICENSE_LUA_5.4.8.txt;$(OutDir)dluma_discord_presence.dll"
          DestinationFolder="$(DlumaPackageDir)" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\build_content_pack.ps1&quot; -OutputPath &quot;$(DlumaContentPackPath)&quot;" />
    <Exec Command="python &quot;$(ProjectDir)tools\build_managed_runtime.py&quot; --output-dir &quot;$(DlumaPackageDir).&quot; --managed-output &quot;$(DlumaManagedOutputDir).&quot; --quest-graph-output &quot;$(DlumaQuestGraphOutputDir).&quot; --catalog-hash &quot;$(ProjectDir)api\generated\dluma_api_catalog.sha256&quot; --loader-symbol-manifest &quot;$(DlumaLoaderAddressManifestPath)&quot;" />
    <Exec Command="python &quot;$(ProjectDir)tools\verify_package_manifest.py&quot; --package-dir &quot;$(DlumaPackageDir).&quot; --mod-name &quot;$(TargetFileName)&quot;" />
    <Exec Condition="'$(Configuration)' == 'Release'" Command="python &quot;$(ProjectDir)tools\prepare_release.py&quot; --package-dir &quot;$(DlumaPackageDir).&quot; --output-dir &quot;$(ProjectDir)release&quot; --refresh-workshop" />
    <Message Importance="high"
             Text="Built clean $(Configuration) package at $(DlumaPackageDir). Any enabled local deployment runs only after package and PE verification." />
  </Target>
  <Target Name="ValidateDlumaLocalDeployment"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(DlumaLocalPropsPath)')"
           Text="DeployLocal requires ignored DLUMA.local.props. Copy DLUMA.local.props.example and set both destinations." />
    <Error Condition="'$(DlumaSubscribedWorkshopModsDir)' == ''"
           Text="DlumaSubscribedWorkshopModsDir is required for DeployLocal." />
    <Error Condition="'$(DlumaDevToolsWorkshopModsDir)' == ''"
           Text="DlumaDevToolsWorkshopModsDir is required for DeployLocal." />
    <Error Condition="!$([System.IO.Path]::IsPathRooted('$(DlumaSubscribedWorkshopModsDir)'))"
           Text="DlumaSubscribedWorkshopModsDir must be an absolute path." />
    <Error Condition="!$([System.IO.Path]::IsPathRooted('$(DlumaDevToolsWorkshopModsDir)'))"
           Text="DlumaDevToolsWorkshopModsDir must be an absolute path." />
    <Error Condition="!Exists('$(DlumaSubscribedWorkshopModsDir)')"
           Text="DlumaSubscribedWorkshopModsDir does not exist." />
    <Error Condition="!Exists('$(DlumaDevToolsWorkshopModsDir)')"
           Text="DlumaDevToolsWorkshopModsDir does not exist." />
  </Target>
  <Target Name="DeployLocalPackage"
          DependsOnTargets="ValidateDlumaLocalDeployment"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Platform)' != 'x64' or ('$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release')"
           Text="Local deployment requires Configuration=Debug or Release and Platform=x64." />
    <Error Condition="'$(DlumaSkipPackage)' == 'true'"
           Text="Local deployment cannot run when DlumaSkipPackage=true." />
    <Exec Command="python &quot;$(ProjectDir)tools\verify_package_manifest.py&quot; --package-dir &quot;$(DlumaPackageDir).&quot; --mod-name &quot;$(TargetFileName)&quot;" />
    <Exec Command="python &quot;$(ProjectDir)tools\verify_pe.py&quot; &quot;$(DlumaPackageDir)$(TargetFileName)&quot;" />
    <Exec Command="python &quot;$(ProjectDir)tools\deploy_local_package.py&quot; --package-dir &quot;$(DlumaPackageDir).&quot; --subscribed-dir &quot;$(DlumaSubscribedWorkshopModsDir).&quot; --devtools-dir &quot;$(DlumaDevToolsWorkshopModsDir).&quot; --built-mod &quot;$(TargetPath)&quot; --built-pak &quot;$(DlumaContentPackPath)&quot; --mod-name &quot;$(TargetFileName)&quot;"
          StandardOutputImportance="High" />
  </Target>
  <Target Name="DeployLocal"
          DependsOnTargets="Build;DeployLocalPackage"
          Condition="'$(DesignTimeBuild)' != 'true'" />
  <Target Name="AutoDeployLocalAfterBuild"
          AfterTargets="PackageWorkshop"
          DependsOnTargets="DeployLocalPackage"
          Condition="'$(DesignTimeBuild)' != 'true'
            and '$(Platform)' == 'x64'
            and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')
            and '$(DlumaAutoDeployLocal)' == 'true'
            and '$(DlumaSkipPackage)' != 'true'
            and Exists('$(DlumaLocalPropsPath)')" />
</Project>
