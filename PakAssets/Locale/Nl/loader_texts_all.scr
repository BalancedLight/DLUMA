String("DLUMA_Ticker_Tanabata", "Fijne %COLOR(1f8c9c)Tanabata!%COLOR(RESET) Schrijf je wensen op een tanzaku en hang die aan een bamboeboom! Welterusten en %COLOR(f28c18)veel geluk!%COLOR(RESET)")

