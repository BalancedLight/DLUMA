// CRASH DIALOG
String("DLUMA_Crash_NeutralTitle", "Dying Light closed unexpectedly") 
String("DLUMA_Crash_Editor_NeutralTitle", "Dying Light Editor closed unexpectedly")
String("DLUMA_Crash_Editor_Context", "The Dying Light Editor closed unexpectedly. Editor MODs can corrupt editor state even when the fault appears elsewhere. Please include the loader log, crash info log, and Chrome's stock crash dump when reporting it.")
String("DLUMA_Crash_Editor_Note", "Chrome's stock crash dump has been preserved. If this continues, disable Editor MODs before reopening the project and report the crash to the Universal Loader maintainers. The Editor will now close.")
String("DLUMA_Crash_Body_Loader", "The fault occurred inside DLUMA. Please include the loader log, crash info log, and crash dump when reporting it.")
String("DLUMA_Crash_Body_Game", "The faulting instruction was in a Dying Light game module. This does not by itself prove where earlier memory corruption originated.")
String("DLUMA_Crash_Body_Windows", "The faulting instruction was in a Windows system module. This does not by itself prove where earlier memory corruption originated.")
String("DLUMA_Crash_Body_External", "The fault occurred inside an external module. This can include drivers, overlays, injectors, or other software loaded into the game.")
String("DLUMA_Crash_Body_Unknown", "Windows could not map the fault address to a loaded module. The crash dump contains the most useful diagnostic context.")
String("DLUMA_Crash_Label_Exception", "Exception")
String("DLUMA_Crash_Label_Module", "Fault module")
String("DLUMA_Crash_Label_Address", "Fault address")
String("DLUMA_Crash_Label_DumpFolder", "Expected crash-dump folder")
String("DLUMA_Crash_Label_InfoLog", "Crash info log")
String("DLUMA_Crash_Note", "If this crash continues to occur, please disable your mods in the main menu and report a bug on the Steam forum for our mod loader. Dying Light will now close.")
String("DLUMA_Crash_Title_01", "\"Oh, fuck this right in the EAR.\"")
String("DLUMA_Crash_Title_02", "\"Shit, the goddamn switch broke down!\"")
String("DLUMA_Crash_Title_03", "\"YOU'VE GOT TO BE FUCKING KIDDING ME!!\"")
String("DLUMA_Crash_Title_04", "\"What's this fucking thing made of, popsicle sticks?!\"")
String("DLUMA_Crash_Title_05", "\"Great, fantastic.\"")
String("DLUMA_Crash_Title_06", "\"Oh, motherFUCKER.\"")
String("DLUMA_Crash_Title_07", "\"Oh, fuck you, asshole.\"")
String("DLUMA_Crash_Title_08", "\"Oh, shit... This is not good...\"")
String("DLUMA_Crash_Title_09", "\"No... Damn it... Not now...\"")
String("DLUMA_Crash_Title_10", "\"Well, that almost worked...\"")
String("DLUMA_Crash_Title_11", "\"Any guess what happened?\"")
String("DLUMA_Crash_Title_12", "\"Yeah, I think I should watch this from a distance.\"")
String("DLUMA_Crash_Title_13", "\"No good. It’s not working.\"")
String("DLUMA_Crash_Title_14", "\"Sonofabitch, not now!\"")
String("DLUMA_Crash_Title_15", "\"No-no-no-no-no...! Damn it!\"")
String("DLUMA_Crash_Title_16", "\"Fuck. Spike, the whole goddamn district went down!\"")

