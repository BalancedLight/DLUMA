String("DLUMA_Ticker_Halloween", "Happy %COLOR(ff6600)Halloween!%COLOR(RESET) Watch out for Volatiles while trick-or-treating!")
String("DLUMA_Ticker_Thanksgiving", "Happy %COLOR(ff6600)Thanksgiving!%COLOR(RESET) Enjoy the Dying Light session with some turkey and pumpkin pie! %COLOR(666666)(Zombie meat isn't all that good.)%COLOR(RESET)")
