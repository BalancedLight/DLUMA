String("DLUMA_Ticker_NewYear", "Happy %COLOR(00c600)New Year!%COLOR(RESET) New year, new you? Get creating!")
String("DLUMA_Ticker_Valentines", "Happy %COLOR(ff007f)Valentine's Day!%COLOR(RESET) Don't forget to give your loved ones a gift!")
String("DLUMA_Ticker_SaintPatricks", "Happy %COLOR(088c3a)Saint Patrick's Day!%COLOR(RESET) Maybe you'll find a pot of gold somewhere in Harran!")
String("DLUMA_Ticker_Easter", "Happy %COLOR(ffcc00)Easter!%COLOR(RESET) Try and find some Easter eggs in custom maps!")
String("DLUMA_Ticker_MothersDay", "Happy %COLOR(fd5d5e)Mother's Day!%COLOR(RESET) \"&Gazi_MothersDay_01DLG01&\"")
String("DLUMA_Ticker_FathersDay", "Happy %COLOR(90c9cb)Father's Day!%COLOR(RESET) Give thanks to your World's Best Dad!")
String("DLUMA_Ticker_IndependenceDay", "Happy %COLOR(ff0000)Independence Day!%COLOR(RESET) Light some firecrackers around Harran!")
String("DLUMA_Ticker_Tanabata", "Happy %COLOR(1f8c9c)Tanabata!%COLOR(RESET) Write your wishes on a tanzaku and hang them on a bamboo tree! Good night, and %COLOR(f28c18)good luck!%COLOR(RESET)")
