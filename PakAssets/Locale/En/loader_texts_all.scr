String("DLUMA_Ticker_ReportErrors", "Please report any errors to the %COLOR(f28c18)DLUMA%COLOR(RESET) Steam forum!")
String("DLUMA_Ticker_TechlandThankYou", "Welcome to %COLOR(f28c18)Dying Light%COLOR(RESET). The whole Techland team wants to thank you for purchasing our game. We've put our heart and soul into bringing you this title. We hope you enjoy it. - Techland")
