String("DLUMA_Ticker_Stats", "Mods active: %COLOR(f28c18){active}%COLOR(RESET) | Mods installed: %COLOR(f28c18){installed}%COLOR(RESET) | Mods with errors: %COLOR(ff0000){errors}%COLOR(RESET)")
