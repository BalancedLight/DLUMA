String("DLUMA_Ticker_GoodNight", "Good Night, and Good Luck.")
String("DLUMA_Ticker_NewMods", "%COLOR(f28c18)New global mods have been detected!%COLOR(RESET) They are disabled until reviewed. Open the %COLOR(f28c18)MODS%COLOR(RESET) page to review and enable them!")
