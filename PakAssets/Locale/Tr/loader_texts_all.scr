String("DLUMA_Crash_NeutralTitle", "Çökme – Dying Light")
String("DLUMA_Crash_Editor_NeutralTitle", "Dying Light Editor beklenmedik şekilde kapandı")
String("DLUMA_Crash_Editor_Context", "Dying Light Editor beklenmedik şekilde kapandı. Hata başka bir yerde görünse bile Editor MOD'ları editör durumunu bozabilir. Bildirim yaparken loader günlüğünü, çökme bilgisi günlüğünü ve Chrome'un özgün çökme dökümünü ekleyin.")
String("DLUMA_Crash_Editor_Note", "Chrome'un özgün çökme dökümü korundu. Sorun devam ederse projeyi yeniden açmadan önce Editor MOD'larını devre dışı bırakın ve çökmeyi Universal Loader bakımcılarına bildirin. Editör şimdi kapanacak.")
String("DLUMA_Crash_Body_Loader", "Hata DLUMA içinde oluştu. Bildirirken yükleyici günlüğünü, çökme bilgi günlüğünü ve crash dump'ı ekleyin.")
String("DLUMA_Crash_Body_Game", "Hataya neden olan komut bir Dying Light oyun modülündeydi. Bu tek başına önceki bellek bozulmasının nereden kaynaklandığını kanıtlamaz.")
String("DLUMA_Crash_Body_Windows", "Hataya neden olan komut bir Windows sistem modülündeydi. Bu tek başına önceki bellek bozulmasının nereden kaynaklandığını kanıtlamaz.")
String("DLUMA_Crash_Body_External", "Hata; sürücü, overlay, injector veya oyuna yüklenen başka bir yazılım gibi harici bir modülde oluştu.")
String("DLUMA_Crash_Body_Unknown", "Windows hata adresini yüklenmiş bir modülle eşleştiremedi. Crash dump en yararlı tanılama bağlamını içerir.")
String("DLUMA_Crash_Label_Exception", "Özel durum")
String("DLUMA_Crash_Label_Module", "Hata modülü")
String("DLUMA_Crash_Label_Address", "Hata adresi")
String("DLUMA_Crash_Label_DumpFolder", "Beklenen crash dump klasörü")
String("DLUMA_Crash_Label_InfoLog", "Çökme bilgi günlüğü")
String("DLUMA_Crash_Note", "Çökme devam ederse ana menüde modları devre dışı bırakın ve sorunu yükleyicinin Steam forumunda bildirin. Dying Light şimdi kapanacak.")
String("DLUMA_Crash_Title_01", "\"Lanet olsun, tam kulağın içinde.\"")
String("DLUMA_Crash_Title_02", "\"Kahretsin, o lanet anahtar bozuldu!\"")
String("DLUMA_Crash_Title_03", "\"Şaka yapıyor olmalısın!\"")
String("DLUMA_Crash_Title_04", "\"Bu şey dondurma çubuklarından mı yapılmış?!\"")
String("DLUMA_Crash_Title_05", "\"Harika, gerçekten harika.\"")
String("DLUMA_Crash_Title_06", "\"Ah, kahretsin.\"")
String("DLUMA_Crash_Title_07", "\"Böyle olması gerekmiyordu.\"")
String("DLUMA_Crash_Title_08", "\"Motor binayı terk etti.\"")
String("DLUMA_Crash_Title_09", "\"Birisi zombilere haber versin.\"")
String("DLUMA_Crash_Title_10", "\"O düğmenin tek bir görevi vardı.\"")
String("DLUMA_Crash_Title_11", "\"Yükleyicinin bir dakikaya ihtiyacı var.\"")
String("DLUMA_Crash_Title_12", "\"Havalı bir çökme.\"")
String("DLUMA_Crash_Title_13", "\"Hayır. Kesinlikle olmaz.\"")
String("DLUMA_Crash_Title_14", "\"Gece az önce daha da karardı.\"")
String("DLUMA_Crash_Title_15", "\"Pahalı göründü.\"")
String("DLUMA_Crash_Title_16", "\"Kahretsin. Spike, bütün bölge çöktü!\"")
