String("DLUMA_Ticker_Thanksgiving", "Szczęśliwego %COLOR(ff6600)Święta Dziękczynienia!%COLOR(RESET) Ciesz się rozgrywką w Dying Light przy indyku i cieście dyniowym! %COLOR(666666)(Mięso zombie nie jest zbyt smaczne.)%COLOR(RESET)")
