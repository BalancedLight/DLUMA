String("DLUMA_Ticker_NewYear", "Szczęśliwego %COLOR(00c600)Nowego Roku!%COLOR(RESET) Nowy rok, nowy ty? Zacznij tworzyć!")
String("DLUMA_Ticker_Valentines", "Szczęśliwych %COLOR(ff007f)Walentynek!%COLOR(RESET) Nie zapomnij podarować prezentu swoim bliskim!")
