String("DLUMA_Ticker_StaticFallback", "Moduł")
String("DLUMA_Ticker_Welcome", "Dziękujemy za korzystanie z %COLOR(f28c18)DLUMA%COLOR(RESET). Ten mod jest na bardzo wczesnym etapie rozwoju i może zawierać błędy. Wkrótce pojawią się kolejne poprawki i funkcje. Dobranoc i powodzenia!")
String("DLUMA_Ticker_Stats", "Aktywne mody: %COLOR(f28c18){active}%COLOR(RESET) | Zainstalowane mody: %COLOR(f28c18){installed}%COLOR(RESET) | Mody z błędami: %COLOR(ff0000){errors}%COLOR(RESET)")
String("DLUMA_Ticker_ErrorHelp", "Sprawdź logi uniwersalnego loadera, aby poznać szczegóły!")
String("DLUMA_Ticker_DevMode", "Tryb deweloperski jest %COLOR(f28c18)włączony%COLOR(RESET). Dostępne są kody i klawisze deweloperskie.")
String("DLUMA_Ticker_ReportErrors", "Wszelkie błędy zgłaszaj na forum Steam %COLOR(f28c18)DLUMA%COLOR(RESET)!")
String("DLUMA_Ticker_TechlandThankYou", "Witamy w %COLOR(f28c18)Dying Light%COLOR(RESET). Cały zespół Techland dziękuje za zakup naszej gry. Włożyliśmy w ten tytuł całe serce i duszę. Mamy nadzieję, że będzie się dobrze bawić. - Techland")
String("DLUMA_Ticker_Active", "DLUMA {version} jest aktywny.")
String("DLUMA_Ticker_Mods", "Otwórz MODS, aby przejrzeć i włączyć zainstalowane mody Lua oraz DLL.")
