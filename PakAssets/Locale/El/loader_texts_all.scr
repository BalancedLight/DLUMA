String("DLUMA_Ticker_HappyHolidays", "%COLOR(00c600)Καλές %COLOR(c60000)γιορτές!%COLOR(RESET) Απολαύστε το Dying Light με μια ζεστή σοκολάτα!")
String("DLUMA_Ticker_Halloween", "Χαρούμενο %COLOR(ff6600)Halloween!%COLOR(RESET) Προσέξτε τους Volatiles όταν βγαίνετε για γλυκά!")
String("DLUMA_Ticker_Valentines", "Χαρούμενη %COLOR(ff007f)Ημέρα του Αγίου Βαλεντίνου!%COLOR(RESET) Μην ξεχάσετε να κάνετε ένα δώρο στους αγαπημένους σας!")
