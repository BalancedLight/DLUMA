String("DLUMA_Ticker_DevMode", "Η λειτουργία προγραμματιστή είναι %COLOR(f28c18)ενεργή%COLOR(RESET). Τα cheat και τα πλήκτρα προγραμματιστή είναι διαθέσιμα.")
String("DLUMA_Ticker_ReportErrors", "Αναφέρετε τυχόν σφάλματα στο φόρουμ Steam του %COLOR(f28c18)DLUMA%COLOR(RESET)!")
String("DLUMA_Ticker_NewYear", "Καλή %COLOR(00c600)Χρονιά!%COLOR(RESET) Νέος χρόνος, νέος εαυτός; Ώρα για δημιουργία!")
String("DLUMA_Ticker_IndependenceDay", "Χαρούμενη %COLOR(ff0000)Ημέρα Ανεξαρτησίας!%COLOR(RESET) Ανάψτε μερικά πυροτεχνήματα στο Χαρράν!")
String("DLUMA_Ticker_Tanabata", "Χαρούμενη %COLOR(1f8c9c)Ταναμπάτα!%COLOR(RESET) Γράψτε τις ευχές σας σε ένα τανζάκου και κρεμάστε το σε ένα μπαμπού! Καληνύχτα και %COLOR(f28c18)καλή τύχη!%COLOR(RESET)")

// El loader localization
String("DLUMA_Mods_CSharpGroup", "Mod C#")
String("DLUMA_Mods_EmptyCSharp", "Δεν βρέθηκαν mods C#.")
