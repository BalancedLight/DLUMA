String("DLUMA_Ticker_DevMode", "Der Entwicklermodus ist %COLOR(f28c18)aktiviert%COLOR(RESET). Cheats und Entwicklertasten sind verfügbar.")
String("DLUMA_Ticker_ReportErrors", "Bitte melde alle Fehler im Steam-Forum des %COLOR(f28c18)DLUMA%COLOR(RESET)!")
String("DLUMA_Ticker_NewYear", "Frohes %COLOR(00c600)Neues Jahr!%COLOR(RESET) Neues Jahr, neues Ich? Werde kreativ!")
String("DLUMA_Ticker_IndependenceDay", "Frohen %COLOR(ff0000)Unabhängigkeitstag!%COLOR(RESET) Zünde ein paar Feuerwerkskörper in Harran!")
String("DLUMA_Ticker_Tanabata", "Fröhliches %COLOR(1f8c9c)Tanabata!%COLOR(RESET) Schreibe deine Wünsche auf einen Tanzaku und hänge ihn an einen Bambusbaum! Gute Nacht und %COLOR(f28c18)viel Glück!%COLOR(RESET)")

// De loader localization
String("DLUMA_Settings_loader_developer_mode_Label", "Entwicklermodus")
String("DLUMA_Settings_loader_developer_mode_Hint", "Aktiviert nach einem Neustart Cheats und Entwicklertasten, überspringt auf unterstützten Player-Versionen die Startlogos und die Wartezeit beim Levelstart und zeigt Lua-Grenzwerte an.")
String("DLUMA_MainMenu_LoaderVersion", "DLUMA {version}")
String("DLUMA_MainMenu_LoaderHash", "SHA-256: {hash}...")
String("DLUMA_MainMenu_LoaderHashUnavailable", "SHA-256: nicht verfügbar")
String("DLUMA_MainMenu_LoaderCommit", "Revision: {commit}")
String("DLUMA_MainMenu_LoaderCommitUnavailable", "Revision: nicht verfügbar")
String("DLUMA_Ticker_StaticFallback", "Ladeprogramm")
String("DLUMA_Ticker_Welcome", "Danke, dass du den %COLOR(f28c18)DLUMA%COLOR(RESET) verwendest. Dieser Mod befindet sich noch in einer sehr frühen Entwicklung und kann Fehler enthalten. Weitere Fehlerbehebungen und Funktionen folgen bald. Gute Nacht und viel Glück!")
String("DLUMA_Ticker_Stats", "Aktive Mods: %COLOR(f28c18){active}%COLOR(RESET) | Installierte Mods: %COLOR(f28c18){installed}%COLOR(RESET) | Mods mit Fehlern: %COLOR(ff0000){errors}%COLOR(RESET)")
String("DLUMA_Ticker_ErrorHelp", "Weitere Details findest du in den Protokollen des Universal Loaders!")
String("DLUMA_Ticker_TechlandThankYou", "Willkommen bei %COLOR(f28c18)Dying Light%COLOR(RESET). Das gesamte Techland-Team möchte dir für den Kauf unseres Spiels danken. Wir haben unser Herz und unsere Seele in diesen Titel gesteckt. Wir hoffen, dass er dir gefällt. - Techland")
String("DLUMA_Ticker_Active", "DLUMA {version} ist aktiv.")
String("DLUMA_Ticker_Mods", "Öffne MODS, um installierte Lua- und DLL-Mods zu prüfen und zu aktivieren.")
String("DLUMA_Ticker_Settings", "Die Loader-Einstellungen findest du unter Optionen.")
String("DLUMA_Ticker_Fixes", "Kompatibilitätskorrekturen für benutzerdefinierte Karten sind aktiv, wenn sie von diesem Build unterstützt werden.")
String("DLUMA_Ticker_Security", "Lua-Mods laufen in einer Sandbox; DLL-Mods haben vollen Prozesszugriff.")
String("DLUMA_Ticker_GoodNight", "Gute Nacht und viel Glück.")
String("DLUMA_Ticker_NewMods", "%COLOR(f28c18)Neue globale Mods wurden erkannt!%COLOR(RESET) Sie bleiben deaktiviert, bis sie überprüft wurden. Öffne die Seite %COLOR(f28c18)MODS%COLOR(RESET), um sie zu überprüfen und zu aktivieren!")
// Saisonale Ereignisse
String("DLUMA_Ticker_Thanksgiving", "Frohes %COLOR(ff6600)Thanksgiving!%COLOR(RESET) Genieße deine Dying-Light-Runde mit Truthahn und Kürbiskuchen! %COLOR(666666)(Zombiefleisch schmeckt nicht besonders gut.)%COLOR(RESET)")
String("DLUMA_Ticker_HappyHolidays", "%COLOR(00c600)Frohe %COLOR(c60000)Feiertage!%COLOR(RESET) Genieße deine Dying-Light-Runde mit einer heißen Schokolade!")
String("DLUMA_Ticker_Halloween", "Frohes %COLOR(ff6600)Halloween!%COLOR(RESET) Hüte dich beim Süßes-oder-Saures-Sammeln vor Volatilen!")
String("DLUMA_Ticker_Valentines", "Schönen %COLOR(ff007f)Valentinstag!%COLOR(RESET) Vergiss nicht, deinen Liebsten ein Geschenk zu machen!")
String("DLUMA_Ticker_Easter", "Frohe %COLOR(ffcc00)Ostern!%COLOR(RESET) Versuche, in benutzerdefinierten Karten ein paar Ostereier zu finden!")
String("DLUMA_Ticker_SaintPatricks", "Frohen %COLOR(088c3a)St. Patrick’s Day!%COLOR(RESET) Vielleicht findest du irgendwo in Harran einen Topf voll Gold!")
String("DLUMA_Ticker_MothersDay", "Alles Gute zum %COLOR(fd5d5e)Muttertag!%COLOR(RESET) \"&Gazi_MothersDay_01DLG01&\"")
